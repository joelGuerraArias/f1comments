.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# =================== Docker / runtime ===================
.docker/
docker-compose.override.local.yaml

# =================== Ficheros generados por la app ===================
# admin_config.json es config local; comentar si quieres versionarla.
# backend/admin_config.json

# Estado runtime del tracking de datos usados (cambia con cada generacion del loop)
backend/race_data_state.json

# Backups y temporales
*.bak
*.tmp
*.temp
*.orig

# Output del frontend bundleado: se regenera con esbuild, pero lo
# dejamos versionado para que el repo arranque sin Node. Si prefieres
# regenerarlo siempre, descomenta la siguiente linea:
# frontend/app.bundle.js
