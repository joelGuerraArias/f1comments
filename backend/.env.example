# f1-dash (motor de datos en vivo)
F1_DASH_REALTIME_URL=http://localhost:4000
F1_DASH_API_URL=http://localhost:4001

# IA y voz
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# OpenAI Speech: por defecto gpt-realtime-2 (motor Realtime para /v1/audio/speech).
# Si tu cuenta no tiene acceso, usar: OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_MODEL=gpt-realtime-2

# Modo Experto (xAI Grok realtime - voz Eve)
# Opcional. Si no lo pones, el boton "EXPERTO" devolvera error al activarse.
XAI_API_KEY=
# Modelo y URL del realtime de xAI (defaults razonables, ajusta si el endpoint cambia)
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
XAI_REALTIME_MODEL=grok-voice-latest
# Cada cuantos segundos se inyecta el estado del API a Eve (default 180 = 3 min)
EXPERT_INJECT_INTERVAL_S=180
